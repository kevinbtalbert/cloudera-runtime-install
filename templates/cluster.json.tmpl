{
  "cdhVersion": "${CDH_VERSION}",
  "cmVersion": "${CM_VERSION}",
  "displayName": "${CLUSTER_NAME}",
  "hostTemplates": [
    {
      "cardinality": 1,
      "refName": "HostTemplate-master",
      "roleConfigGroupsRefNames": [
        "zookeeper-SERVER-BASE",
        "hdfs-NAMENODE-BASE",
        "hdfs-SECONDARYNAMENODE-BASE",
        "hdfs-DATANODE-BASE",
        "hdfs-BALANCER-BASE",
        "hdfs-HTTPFS-BASE",
        "yarn-RESOURCEMANAGER-BASE",
        "yarn-NODEMANAGER-BASE",
        "yarn-JOBHISTORY-BASE",
        "queuemanager-QUEUEMANAGER_WEBAPP-BASE",
        "queuemanager-QUEUEMANAGER_STORE-BASE",
        "tez-GATEWAY-BASE",
        "hive-GATEWAY-BASE",
        "hive-HIVEMETASTORE-BASE",
        "hive_on_tez-GATEWAY-BASE",
        "hive_on_tez-HIVESERVER2-BASE",
        "hue-HUE_SERVER-BASE",
        "hue-HUE_LOAD_BALANCER-BASE",
        "kafka-KAFKA_BROKER-BASE",
        "impala-IMPALAD-BASE",
        "impala-STATESTORE-BASE",
        "impala-CATALOGSERVER-BASE",
        "nifi-NIFI_NODE-BASE",
        "nifiregistry-NIFI_REGISTRY_SERVER-BASE",
        "flink-FLINK_HISTORY_SERVER-BASE",
        "flink-GATEWAY-BASE",
        "sql_stream_builder-STREAMING_SQL_ENGINE-BASE",
        "sql_stream_builder-MATERIALIZED_VIEW_ENGINE-BASE"
      ]
    }
  ],
  "instantiator": {
    "clusterName": "${CLUSTER_NAME}",
    "hosts": [
      {
        "hostName": "${CLUSTER_HOST}",
        "hostTemplateRefName": "HostTemplate-master"
      }
    ]
  },
  "products": [
    {
      "product": "CDH",
      "version": "${CDH_BUILD}"
    },
    {
      "product": "CFM",
      "version": "${CFM_BUILD}"
    },
    {
      "product": "FLINK",
      "version": "${CSA_FLINK_BUILD}"
    }
  ],
  "repositories": [
    "${CDH_PARCEL_REPO}",
    "${CFM_PARCEL_REPO_URL}",
    "${CSA_PARCEL_REPO}"
  ],
  "services": [
    {
      "refName": "zookeeper",
      "serviceType": "ZOOKEEPER",
      "displayName": "ZooKeeper",
      "serviceConfigs": [],
      "roleConfigGroups": [
        {
          "refName": "zookeeper-SERVER-BASE",
          "roleType": "SERVER",
          "base": true,
          "configs": []
        }
      ]
    },
    {
      "refName": "hdfs",
      "serviceType": "HDFS",
      "displayName": "HDFS",
      "serviceConfigs": [
        {
          "name": "dfs_replication",
          "value": "1"
        }
      ],
      "roleConfigGroups": [
        {
          "refName": "hdfs-NAMENODE-BASE",
          "roleType": "NAMENODE",
          "base": true,
          "configs": []
        },
        {
          "refName": "hdfs-SECONDARYNAMENODE-BASE",
          "roleType": "SECONDARYNAMENODE",
          "base": true,
          "configs": []
        },
        {
          "refName": "hdfs-DATANODE-BASE",
          "roleType": "DATANODE",
          "base": true,
          "configs": []
        },
        {
          "refName": "hdfs-BALANCER-BASE",
          "roleType": "BALANCER",
          "base": true,
          "configs": []
        },
        {
          "refName": "hdfs-HTTPFS-BASE",
          "roleType": "HTTPFS",
          "base": true,
          "configs": []
        }
      ]
    },
    {
      "refName": "yarn",
      "serviceType": "YARN",
      "displayName": "YARN",
      "serviceConfigs": [],
      "roleConfigGroups": [
        {
          "refName": "yarn-RESOURCEMANAGER-BASE",
          "roleType": "RESOURCEMANAGER",
          "base": true,
          "configs": [
            {
              "name": "yarn_scheduler_maximum_allocation_mb",
              "value": "8192"
            }
          ]
        },
        {
          "refName": "yarn-NODEMANAGER-BASE",
          "roleType": "NODEMANAGER",
          "base": true,
          "configs": [
            {
              "name": "yarn_nodemanager_resource_memory_mb",
              "value": "8192"
            }
          ]
        },
        {
          "refName": "yarn-JOBHISTORY-BASE",
          "roleType": "JOBHISTORY",
          "base": true,
          "configs": []
        }
      ]
    },
    {
      "refName": "queuemanager",
      "serviceType": "QUEUEMANAGER",
      "displayName": "YARN Queue Manager",
      "serviceConfigs": [],
      "roleConfigGroups": [
        {
          "refName": "queuemanager-QUEUEMANAGER_WEBAPP-BASE",
          "roleType": "QUEUEMANAGER_WEBAPP",
          "base": true,
          "configs": []
        },
        {
          "refName": "queuemanager-QUEUEMANAGER_STORE-BASE",
          "roleType": "QUEUEMANAGER_STORE",
          "base": true,
          "configs": []
        }
      ]
    },
    {
      "refName": "tez",
      "serviceType": "TEZ",
      "displayName": "Tez",
      "serviceConfigs": [],
      "roleConfigGroups": [
        {
          "refName": "tez-GATEWAY-BASE",
          "roleType": "GATEWAY",
          "base": true,
          "configs": []
        }
      ]
    },
    {
      "refName": "hive",
      "serviceType": "HIVE",
      "displayName": "Hive Metastore",
      "serviceConfigs": [
        {
          "name": "hive_metastore_database_type",
          "value": "postgresql"
        },
        {
          "name": "hive_metastore_database_host",
          "value": "${DB_HOST}"
        },
        {
          "name": "hive_metastore_database_port",
          "value": "${DB_PORT}"
        },
        {
          "name": "hive_metastore_database_name",
          "value": "${HIVE_DB_NAME}"
        },
        {
          "name": "hive_metastore_database_user",
          "value": "${HIVE_DB_USER}"
        },
        {
          "name": "hive_metastore_database_password",
          "value": "${HIVE_DB_PASS}"
        }
      ],
      "roleConfigGroups": [
        {
          "refName": "hive-GATEWAY-BASE",
          "roleType": "GATEWAY",
          "base": true,
          "configs": []
        },
        {
          "refName": "hive-HIVEMETASTORE-BASE",
          "roleType": "HIVEMETASTORE",
          "base": true,
          "configs": []
        }
      ]
    },
    {
      "refName": "hive_on_tez",
      "serviceType": "HIVE_ON_TEZ",
      "displayName": "Hive on Tez",
      "serviceConfigs": [
        {
          "name": "hive_proxy_user_groups_list",
          "value": "hue"
        }
      ],
      "roleConfigGroups": [
        {
          "refName": "hive_on_tez-GATEWAY-BASE",
          "roleType": "GATEWAY",
          "base": true,
          "configs": []
        },
        {
          "refName": "hive_on_tez-HIVESERVER2-BASE",
          "roleType": "HIVESERVER2",
          "base": true,
          "configs": [
            {
              "name": "hive_hs2_config_safety_valve",
              "value": "<property><name>metastore.warehouse.tenant.colocation</name><value>true</value></property>"
            }
          ]
        }
      ]
    },
    {
      "refName": "kafka",
      "serviceType": "KAFKA",
      "displayName": "Kafka",
      "serviceConfigs": [
        {
          "name": "zookeeper.secure.connection.enable",
          "value": "${KAFKA_ZK_SECURE}"
        }
      ],
      "roleConfigGroups": [
        {
          "refName": "kafka-KAFKA_BROKER-BASE",
          "roleType": "KAFKA_BROKER",
          "base": true,
          "configs": [
            {
              "name": "metadata.store",
              "value": "Zookeeper"
            },
            {
              "name": "authenticate.zookeeper.connection",
              "value": "false"
            },
            {
              "name": "zookeeper.set.acl",
              "value": "false"
            }
          ]
        }
      ]
    },
    {
      "refName": "impala",
      "serviceType": "IMPALA",
      "displayName": "Impala",
      "serviceConfigs": [],
      "roleConfigGroups": [
        {
          "refName": "impala-IMPALAD-BASE",
          "roleType": "IMPALAD",
          "base": true,
          "configs": []
        },
        {
          "refName": "impala-STATESTORE-BASE",
          "roleType": "STATESTORE",
          "base": true,
          "configs": []
        },
        {
          "refName": "impala-CATALOGSERVER-BASE",
          "roleType": "CATALOGSERVER",
          "base": true,
          "configs": []
        }
      ]
    },
    {
      "refName": "hue",
      "serviceType": "HUE",
      "displayName": "Hue",
      "serviceConfigs": [
        {
          "name": "database_type",
          "value": "postgresql"
        },
        {
          "name": "database_host",
          "value": "${DB_HOST}"
        },
        {
          "name": "database_port",
          "value": "${DB_PORT}"
        },
        {
          "name": "database_name",
          "value": "${HUE_DB_NAME}"
        },
        {
          "name": "database_user",
          "value": "${HUE_DB_USER}"
        },
        {
          "name": "database_password",
          "value": "${HUE_DB_PASS}"
        }
      ],
      "roleConfigGroups": [
        {
          "refName": "hue-HUE_SERVER-BASE",
          "roleType": "HUE_SERVER",
          "base": true,
          "configs": []
        },
        {
          "refName": "hue-HUE_LOAD_BALANCER-BASE",
          "roleType": "HUE_LOAD_BALANCER",
          "base": true,
          "configs": [
            {
              "name": "listen",
              "value": "8889"
            }
          ]
        }
      ]
    },
    {
      "refName": "nifi",
      "serviceType": "NIFI",
      "displayName": "NiFi",
      "serviceConfigs": [],
      "roleConfigGroups": [
        {
          "refName": "nifi-NIFI_NODE-BASE",
          "roleType": "NIFI_NODE",
          "base": true,
          "configs": [
            {
              "name": "nifi.web.http.port",
              "value": "8080"
            },
            {
              "name": "nifi.web.https.port",
              "value": "8443"
            },
            {
              "name": "nifi.remote.input.secure",
              "value": "false"
            },
            {
              "name": "nifi.remote.input.socket.port",
              "value": "50999"
            },
            {
              "name": "nifi.remote.input.host",
              "value": "${CLUSTER_HOST}"
            },
            {
              "name": "nifi.cluster.flow.election.max.wait.time",
              "value": "10 secs"
            },
            {
              "name": "java.arg.2",
              "value": "-Xms1g"
            },
            {
              "name": "java.arg.3",
              "value": "-Xmx2g"
            },
            {
              "name": "nifi.jdk.home",
              "value": "${NIFI_JAVA_HOME}"
            }
          ]
        }
      ]
    },
    {
      "refName": "nifiregistry",
      "serviceType": "NIFIREGISTRY",
      "displayName": "NiFi Registry",
      "serviceConfigs": [],
      "roleConfigGroups": [
        {
          "refName": "nifiregistry-NIFI_REGISTRY_SERVER-BASE",
          "roleType": "NIFI_REGISTRY_SERVER",
          "base": true,
          "configs": [
            {
              "name": "nifi.registry.web.http.port",
              "value": "18080"
            },
            {
              "name": "nifi.registry.web.https.port",
              "value": "18433"
            },
            {
              "name": "nifi.registry.jdk.home",
              "value": "${NIFI_JAVA_HOME}"
            },
            {
              "name": "nifi.registry.db.url",
              "value": "jdbc:postgresql://${DB_HOST}:${DB_PORT}/${REG_DB_NAME}"
            },
            {
              "name": "nifi.registry.db.driver.class",
              "value": "org.postgresql.Driver"
            },
            {
              "name": "nifi.registry.db.driver.directory",
              "value": "/usr/share/java"
            },
            {
              "name": "nifi.registry.db.username",
              "value": "${REG_DB_USER}"
            },
            {
              "name": "nifi.registry.db.password",
              "value": "${REG_DB_PASS}"
            },
            {
              "name": "nifi.registry.db.maxConnections",
              "value": "5"
            }
          ]
        }
      ]
    },
    {
      "refName": "flink",
      "serviceType": "FLINK",
      "displayName": "Flink",
      "serviceConfigs": [],
      "roleConfigGroups": [
        {
          "refName": "flink-FLINK_HISTORY_SERVER-BASE",
          "roleType": "FLINK_HISTORY_SERVER",
          "base": true,
          "configs": []
        },
        {
          "refName": "flink-GATEWAY-BASE",
          "roleType": "GATEWAY",
          "base": true,
          "configs": []
        }
      ]
    },
    {
      "refName": "sql_stream_builder",
      "serviceType": "SQL_STREAM_BUILDER",
      "displayName": "SQL Stream Builder",
      "serviceConfigs": [
        {
          "name": "database_type",
          "value": "postgresql"
        },
        {
          "name": "database_host",
          "value": "${DB_HOST}"
        },
        {
          "name": "database_port",
          "value": "${DB_PORT}"
        },
        {
          "name": "database_schema",
          "value": "${SSB_DB_NAME}"
        },
        {
          "name": "database_user",
          "value": "${SSB_DB_USER}"
        },
        {
          "name": "database_password",
          "value": "${SSB_DB_PASS}"
        }
      ],
      "roleConfigGroups": [
        {
          "refName": "sql_stream_builder-STREAMING_SQL_ENGINE-BASE",
          "roleType": "STREAMING_SQL_ENGINE",
          "base": true,
          "configs": []
        },
        {
          "refName": "sql_stream_builder-MATERIALIZED_VIEW_ENGINE-BASE",
          "roleType": "MATERIALIZED_VIEW_ENGINE",
          "base": true,
          "configs": [
            {
              "name": "ssb.mve.datasource.url",
              "value": "jdbc:postgresql://${DB_HOST}:${DB_PORT}/${SSB_DB_NAME}"
            },
            {
              "name": "ssb.mve.datasource.username",
              "value": "${SSB_DB_USER}"
            },
            {
              "name": "ssb.mve.datasource.password",
              "value": "${SSB_DB_PASS}"
            }
          ]
        }
      ]
    }
  ]
}
